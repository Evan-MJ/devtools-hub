# Cloudflare API Token for Wrangler Deployment
# Source this file before running wrangler commands:
#   source .env && npx wrangler pages deploy . --project-name devtools-hub --branch main
#
# Get your token at: https://dash.cloudflare.com/profile/api-tokens
# Required scope: Cloudflare Pages: Edit
CLOUDFLARE_API_TOKEN="<your-token-here>"
